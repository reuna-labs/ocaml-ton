opam-version: "2.0"
synopsis: "A TON light client as a MirageOS unikernel"
description: """
Connects to a liteserver, asks for an account and verifies the answer
against the block. Almost all of it is the same pure code the offline test
suite runs; only the flow is new."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-ton"
bug-reports: "https://github.com/reuna-labs/ocaml-ton/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "4.14"}
  "ton-cell"
  "ton-tlb"
  "ton-address"
  "ton-proof"
  "ton-lite-client"
  "ton-lite-client-mirage"
  "tcpip"
  "mirage-crypto-rng" {>= "2.1.0"}
  "ipaddr"
  "logs"
  "lwt" {>= "5.6.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-ton.git"
