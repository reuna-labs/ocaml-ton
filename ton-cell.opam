# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "TON cells and Bag-of-Cells codec (pure OCaml, unikernel-safe)"
description: """
Bit-addressed cells, the representation hash (including exotic cells and
Merkle proofs), and the Bag-of-Cells container format. No OS or IO
dependencies, so it links into a MirageOS/Solo5 unikernel."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-ton"
bug-reports: "https://github.com/reuna-labs/ocaml-ton/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "4.14"}
  "digestif" {>= "1.1.4"}
  "zarith" {>= "1.12"}
  "web3-codec"
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-ton.git"

pin-depends: [
  # web3-codec is in a separate private repository, and its multiformats
  # family is on feat/multiformats, not main. web3-codec declares its own
  # pin-depends for evm-abi, so that one is not repeated here. Regenerating
  # from dune-project drops this block -- dune cannot express pin-depends.
  [
    "web3-codec.dev"
    "git+https://github.com/reuna-labs/ocaml-web3-codec.git#feat/multiformats"
  ]
]
