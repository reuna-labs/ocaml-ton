depends: [
  "dune" {>= "3.8"}
  "ocaml" {>= "4.14"}
  "ton-lite-client"
  "ton-adnl"
  "mirage-flow" {>= "5.0.0"}
  "cstruct" {>= "6.0.0"}
  "lwt" {>= "5.6.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
