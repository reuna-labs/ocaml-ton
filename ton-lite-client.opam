# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "TON liteserver client, with no IO"
description: """
Typed liteserver queries and session bookkeeping over the ADNL state
machine. Transport is somebody else's problem, which is what lets the whole
protocol be tested from a recorded transcript."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-ton"
bug-reports: "https://github.com/reuna-labs/ocaml-ton/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "4.14"}
  "ton-tl"
  "ton-tl-schema"
  "ton-adnl"
  "ton-address"
  "ton-cell"
  "ton-tlb"
  "web3-codec"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-ton.git"

pin-depends: [
  # web3-codec is in a separate private repository, and its multiformats
  # family is on feat/multiformats, not main.
  #
  # evm-abi is repeated here even though nothing in this repository depends on
  # it directly, and opam lint warns about that. It is necessary: pin-depends
  # are NOT applied transitively. Pinning web3-codec from git does not pin what
  # web3-codec's own pin-depends name, so resolution fails with
  #   ton-cell -> web3-codec -> evm-abi -> evm-types unknown package
  # so the whole closure has to be named here, not just the direct edge.
  # until evm-abi is pinned here too. Verified, not assumed.
  #
  # Regenerating from dune-project drops this block -- dune cannot express
  # pin-depends.
  [
    "web3-codec.dev"
    "git+https://github.com/reuna-labs/ocaml-web3-codec.git#feat/multiformats"
  ]
  [
    "evm-abi.0.2.0~alpha1"
    "git+https://github.com/reuna-labs/ocaml-evm.git#main"
  ]
  [
    "evm-types.0.2.0~alpha1"
    "git+https://github.com/reuna-labs/ocaml-evm.git#main"
  ]
  [
    "digestif.1.4.0"
    "git+https://github.com/reuna-labs/digestif.git#main"
  ]
]
