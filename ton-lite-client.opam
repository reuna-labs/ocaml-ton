# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "TON liteserver client, with no IO"
description: """
Typed liteserver queries and session bookkeeping over the ADNL state
machine. Transport is somebody else's problem, which is what lets the whole
protocol be tested from a recorded transcript."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-ton"
bug-reports: "https://github.com/reuna-labs/ocaml-ton/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "4.14"}
  "ton-tl"
  "ton-tl-schema"
  "ton-adnl"
  "ton-address"
  "ton-cell"
  "ton-tlb"
  "web3-codec"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-ton.git"

pin-depends: [
  # web3-codec is in a separate private repository, and its multiformats
  # family is on feat/multiformats, not main. web3-codec declares its own
  # pin-depends for evm-abi, so that one is not repeated here. Regenerating
  # from dune-project drops this block -- dune cannot express pin-depends.
  [
    "web3-codec.dev"
    "git+https://github.com/reuna-labs/ocaml-web3-codec.git#feat/multiformats"
  ]
]
