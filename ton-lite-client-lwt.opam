depends: [
  "dune" {>= "3.8"}
  "ocaml" {>= "4.14"}
  "ton-lite-client"
  "ton-adnl"
  "mirage-crypto-rng" {>= "2.1.0"}
  "lwt" {>= "5.6.0"}
  "logs"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
