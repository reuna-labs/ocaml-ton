opam-version: "2.0"
version: "0.1.0~alpha2"
synopsis: "Verifying TON Merkle proofs"
description: """
Checks that a liteserver's answer about an account really follows from a
block root hash, rather than taking its word for it. Includes proving that
an account does not exist, which needs the proof to cover where it would be."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-ton"
bug-reports: "https://github.com/reuna-labs/ocaml-ton/issues"
depends: [
  "dune" {>= "3.8"}
  "ocaml" {>= "4.14"}
  "ton-cell"
  "ton-tlb"
  "ton-address"
  "ton-crypto"
  "ton-tl"
  "ton-tl-schema"
  "digestif" {>= "1.1.4"}
  "zarith" {>= "1.12"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-ton.git"
