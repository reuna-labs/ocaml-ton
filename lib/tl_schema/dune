(library
 (name ton_tl_schema)
 (public_name ton-tl-schema)
 (modules lite adnl)
 (libraries ton-tl))

; The generated sources are committed so that building this library never
; needs the compiler in tools/tlgen. These rules regenerate them into a
; scratch copy and make `dune runtest` fail if the committed file has drifted;
; `dune promote` then updates it.

(rule
 (package ton-tl-schema)
 (targets lite.ml.gen)
 (deps
  %{workspace_root}/schema/lite_api.tl
  %{workspace_root}/tools/tlgen/tlgen.exe)
 (action
  (run %{workspace_root}/tools/tlgen/tlgen.exe --schema
    %{workspace_root}/schema/lite_api.tl -o %{targets})))

(rule
 (package ton-tl-schema)
 (targets adnl.ml.gen)
 (deps
  %{workspace_root}/schema/ton_api.tl
  %{workspace_root}/tools/tlgen/tlgen.exe)
 (action
  (run %{workspace_root}/tools/tlgen/tlgen.exe --schema
    %{workspace_root}/schema/ton_api.tl --only pub.,tcp.,ton.blockId -o %{targets})))

(rule
 (package ton-tl-schema)
 (alias runtest)
 (action
  (diff lite.ml lite.ml.gen)))

(rule
 (package ton-tl-schema)
 (alias runtest)
 (action
  (diff adnl.ml adnl.ml.gen)))
