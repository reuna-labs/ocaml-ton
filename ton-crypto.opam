opam-version: "2.0"
version: "0.1.0~alpha2"
synopsis: "TON cryptography: Ed25519 keys and mnemonics"
description: """
Key handling for TON: Ed25519 signing over mirage-crypto, and the TON
mnemonic scheme (BIP-39 wordlist with PBKDF2-HMAC-SHA-512, but no BIP-39
checksum)."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-ton"
bug-reports: "https://github.com/reuna-labs/ocaml-ton/issues"
depends: [
  "dune" {>= "3.8"}
  "ocaml" {>= "4.14"}
  "digestif" {>= "1.1.4"}
  "mirage-crypto-pbkdf2"
  "mirage-crypto-ec" {>= "2.1.0"}
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-ton.git"
