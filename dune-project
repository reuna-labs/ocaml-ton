(lang dune 3.0)
(name ton)
(generate_opam_files true)
(source (github reuna-labs/ocaml-ton))
(license ISC)
(authors "Gil Bahat <bahat.gil@gmail.com>")
(maintainers "Gil Bahat <bahat.gil@gmail.com>")

(package
 (name ton-cell)
 (synopsis "TON cells and Bag-of-Cells codec (pure OCaml, unikernel-safe)")
 (description
  "Bit-addressed cells, the representation hash (including exotic cells and\nMerkle proofs), and the Bag-of-Cells container format. No OS or IO\ndependencies, so it links into a MirageOS/Solo5 unikernel.")
 (depends
  (ocaml (>= 4.14))
  (digestif (>= 1.1.4))
  (zarith (>= 1.12))
  web3-codec
  (alcotest :with-test)
  (qcheck-core :with-test)
  (qcheck-alcotest :with-test)))

(package
 (name ton-address)
 (synopsis "TON address parsing and formatting")
 (description
  "Raw and user-friendly TON addresses, including bounceable, non-bounceable\nand testnet tags, CRC-16/XMODEM validation and both base64 alphabets.")
 (depends
  (ocaml (>= 4.14))
  web3-codec
  (base64 (>= 3.5.0))
  (alcotest :with-test)))

(package
 (name ton-tlb)
 (synopsis "TON TL-B types: dictionaries, coins, messages, accounts")
 (description
  "Decoders and encoders for the TL-B schemas that describe on-chain data:\nhashmaps, currency amounts, addresses in cells, messages, state init and\naccount state.")
 (depends
  (ocaml (>= 4.14))
  ton-cell
  ton-address
  (zarith (>= 1.12))
  (alcotest :with-test)
  (qcheck-core :with-test)
  (qcheck-alcotest :with-test)))

(package
 (name ton-crypto)
 (synopsis "TON cryptography: Ed25519 keys and mnemonics")
 (description
  "Key handling for TON: Ed25519 signing over mirage-crypto, and the TON\nmnemonic scheme (BIP-39 wordlist with PBKDF2-HMAC-SHA-512, but no BIP-39\nchecksum).")
 (depends
  (ocaml (>= 4.14))
  (digestif (>= 1.1.4))
  (mirage-crypto-ec (>= 2.1.0))
  (alcotest :with-test)
  (qcheck-core :with-test)
  (qcheck-alcotest :with-test)))

(package
 (name ton-wallet)
 (synopsis "TON wallet contracts v3R2, v4R2 and v5R1")
 (description
  "Address derivation and signed transfer construction for the standard TON\nwallet contracts. Entirely offline: nothing here needs a network or a clock.")
 (depends
  (ocaml (>= 4.14))
  ton-cell
  ton-tlb
  ton-address
  ton-crypto
  (base64 (>= 3.5.0))
  (zarith (>= 1.12))
  (alcotest :with-test)))

(package
 (name ton-tl)
 (synopsis "The TL binary wire format")
 (description
  "Reader and writer for TL, the RPC schema language ADNL and the liteserver\nprotocol use. Unrelated to TL-B, which describes cell layouts.")
 (depends
  (ocaml (>= 4.14))
  web3-codec
  (alcotest :with-test)
  (qcheck-core :with-test)
  (qcheck-alcotest :with-test)))

(package
 (name ton-tl-schema)
 (synopsis "Generated TL bindings for the TON liteserver protocol")
 (description
  "OCaml encoders and decoders generated by tools/tlgen from the vendored TL\nschemas. The generated source is committed; regenerating it is a developer\nstep, not a build step.")
 (depends
  (ocaml (>= 4.14))
  ton-tl
  (alcotest :with-test)))
