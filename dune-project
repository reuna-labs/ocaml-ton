(lang dune 3.8)
(name ton)
(version 0.1.0~alpha2)
(generate_opam_files true)
(source (github reuna-labs/ocaml-ton))
(license ISC)
(authors "Gil Bahat <bahat.gil@gmail.com>")
(maintainers "Gil Bahat <bahat.gil@gmail.com>")

(package
 (name ton-cell)
 (synopsis "TON cells and Bag-of-Cells codec (pure OCaml, unikernel-safe)")
 (description
  "Bit-addressed cells, the representation hash (including exotic cells and\nMerkle proofs), and the Bag-of-Cells container format. No OS or IO\ndependencies, so it links into a MirageOS/Solo5 unikernel.")
 (depends
  (ocaml (>= 4.14))
  (digestif (>= 1.1.4))
  (zarith (>= 1.12))
  web3-codec
  (alcotest :with-test)
  (qcheck-core :with-test)
  (qcheck-alcotest :with-test)))

(package
 (name ton-address)
 (synopsis "TON address parsing and formatting")
 (description
  "Raw and user-friendly TON addresses, including bounceable, non-bounceable\nand testnet tags, CRC-16/XMODEM validation and both base64 alphabets.")
 (depends
  (ocaml (>= 4.14))
  web3-codec
  (base64 (>= 3.5.0))
  (alcotest :with-test)))

(package
 (name ton-tlb)
 (synopsis "TON TL-B types: dictionaries, coins, messages, accounts")
 (description
  "Decoders and encoders for the TL-B schemas that describe on-chain data:\nhashmaps, currency amounts, addresses in cells, messages, state init and\naccount state.")
 (depends
  (ocaml (>= 4.14))
  ton-cell
  ton-address
  (zarith (>= 1.12))
  (alcotest :with-test)
  (qcheck-core :with-test)
  (qcheck-alcotest :with-test)))

(package
 (name ton-crypto)
 (synopsis "TON cryptography: Ed25519 keys and mnemonics")
 (description
  "Key handling for TON: Ed25519 signing over mirage-crypto, and the TON\nmnemonic scheme (BIP-39 wordlist with PBKDF2-HMAC-SHA-512, but no BIP-39\nchecksum).")
 (depends
  (ocaml (>= 4.14))
  (digestif (>= 1.1.4))
  (mirage-crypto-ec (>= 2.1.0))
  (alcotest :with-test)
  (qcheck-core :with-test)
  (qcheck-alcotest :with-test)))

(package
 (name ton-wallet)
 (synopsis "TON wallet contracts v3R2, v4R2 and v5R1")
 (description
  "Address derivation and signed transfer construction for the standard TON\nwallet contracts. Entirely offline: nothing here needs a network or a clock.")
 (depends
  (ocaml (>= 4.14))
  ton-cell
  ton-tlb
  ton-address
  ton-crypto
  (base64 (>= 3.5.0))
  (zarith (>= 1.12))
  (alcotest :with-test)))

(package
 (name ton-tl)
 (synopsis "The TL binary wire format")
 (description
  "Reader and writer for TL, the RPC schema language ADNL and the liteserver\nprotocol use. Unrelated to TL-B, which describes cell layouts.")
 (depends
  (ocaml (>= 4.14))
  web3-codec
  (alcotest :with-test)
  (qcheck-core :with-test)
  (qcheck-alcotest :with-test)))

(package
 (name ton-tl-schema)
 (synopsis "Generated TL bindings for the TON liteserver protocol")
 (description
  "OCaml encoders and decoders generated by tools/tlgen from the vendored TL\nschemas. The generated source is committed; regenerating it is a developer\nstep, not a build step.")
 (depends
  (ocaml (>= 4.14))
  ton-tl
  (alcotest :with-test)))

(package
 (name ton-adnl)
 (synopsis "ADNL over TCP, as a state machine with no IO")
 (description
  "The ADNL handshake and framing expressed as bytes in, bytes out. Nothing\nhere opens a socket or reads a clock, so a whole encrypted session is\nreproducible from its inputs and can be replayed offline in tests.")
 (depends
  (ocaml (>= 4.14))
  ton-tl
  ton-tl-schema
  ton-crypto
  (mirage-crypto (>= 2.1.0))
  (digestif (>= 1.1.4))
  (alcotest :with-test)
  (qcheck-core :with-test)
  (qcheck-alcotest :with-test)))

(package
 (name ton-lite-client)
 (synopsis "TON liteserver client, with no IO")
 (description
  "Typed liteserver queries and session bookkeeping over the ADNL state\nmachine. Transport is somebody else's problem, which is what lets the whole\nprotocol be tested from a recorded transcript.")
 (depends
  (ocaml (>= 4.14))
  ton-tl
  ton-tl-schema
  ton-adnl
  ton-address
  ton-cell
  ton-tlb
  web3-codec
  (alcotest :with-test)))

(package
 (name ton-lite-client-lwt)
 (synopsis "Unix transport for the TON liteserver client")
 (description
  "A TCP socket, a read loop and a table of outstanding queries. All the\nprotocol lives in ton-adnl and ton-lite-client, which is why this is small.")
 (depends
  (ocaml (>= 4.14))
  ton-lite-client
  ton-adnl
  (mirage-crypto-rng (>= 2.1.0))
  (lwt (>= 5.6.0))
  logs))

(package
 (name ton-proof)
 (synopsis "Verifying TON Merkle proofs")
 (description
  "Checks that a liteserver's answer about an account really follows from a\nblock root hash, rather than taking its word for it. Includes proving that\nan account does not exist, which needs the proof to cover where it would be.")
 (depends
  (ocaml (>= 4.14))
  ton-cell
  ton-tlb
  ton-address
  ton-crypto
  ton-tl
  ton-tl-schema
  (digestif (>= 1.1.4))
  (zarith (>= 1.12))
  (alcotest :with-test)))

(package
 (name ton-lite-client-mirage)
 (synopsis "MirageOS transport for the TON liteserver client")
 (description
  "Drives the liteserver protocol over any Mirage_flow.S -- a TCP connection,\na vsock channel out of a confidential guest, or an in-memory pipe in a test.\nThe caller opens the flow; no protocol code lives here.")
 (depends
  (ocaml (>= 4.14))
  ton-lite-client
  ton-adnl
  (mirage-flow (>= 5.0.0))
  (cstruct (>= 6.0.0))
  (lwt (>= 5.6.0))))

(package
 (name ton-light-client)
 (synopsis "A TON light client as a MirageOS unikernel")
 (description
  "Connects to a liteserver, asks for an account and verifies the answer\nagainst the block. Almost all of it is the same pure code the offline test\nsuite runs; only the flow is new.")
 (depends
  (ocaml (>= 4.14))
  ton-cell
  ton-tlb
  ton-address
  ton-proof
  ton-lite-client
  ton-lite-client-mirage
  tcpip
  (mirage-crypto-rng (>= 2.1.0))
  ipaddr
  logs
  (lwt (>= 5.6.0))))
