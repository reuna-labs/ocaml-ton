opam-version: "2.0"
synopsis: "The TL binary wire format"
description: """
Reader and writer for TL, the RPC schema language ADNL and the liteserver
protocol use. Unrelated to TL-B, which describes cell layouts."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-ton"
bug-reports: "https://github.com/reuna-labs/ocaml-ton/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "4.14"}
  "web3-codec"
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-ton.git"
