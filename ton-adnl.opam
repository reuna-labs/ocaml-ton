# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "ADNL over TCP, as a state machine with no IO"
description: """
The ADNL handshake and framing expressed as bytes in, bytes out. Nothing
here opens a socket or reads a clock, so a whole encrypted session is
reproducible from its inputs and can be replayed offline in tests."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-ton"
bug-reports: "https://github.com/reuna-labs/ocaml-ton/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "4.14"}
  "ton-tl"
  "ton-tl-schema"
  "ton-crypto"
  "mirage-crypto" {>= "2.1.0"}
  "digestif" {>= "1.1.4"}
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-ton.git"
